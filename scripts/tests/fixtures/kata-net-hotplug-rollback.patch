From 7b1a7ad5ae752c8cf128338e11a1e253ee94b72d Mon Sep 17 00:00:00 2001
From: Li Yi <denverdino@gmail.com>
Date: Tue, 6 Oct 2026 14:55:51 +0800
Subject: [PATCH] fix: roll back failed Dragonball network hotplug

---
 src/dragonball/src/device_manager/mod.rs      |  43 ++-
 .../src/device_manager/net_dev_mgr.rs         | 252 ++++++++++++++++--
 2 files changed, 267 insertions(+), 28 deletions(-)

diff --git a/src/dragonball/src/device_manager/mod.rs b/src/dragonball/src/device_manager/mod.rs
index 051c2eb6f..a9aa2af36 100644
--- a/src/dragonball/src/device_manager/mod.rs
+++ b/src/dragonball/src/device_manager/mod.rs
@@ -191,6 +191,16 @@ pub enum DeviceMgrError {
     #[error("failed to allocate/free device resources: {0}")]
     ResourceError(#[source] crate::resource_manager::ResourceError),
 
+    /// A failed device operation could not be fully rolled back.
+    #[error("{operation}; device rollback failed: {cleanup}")]
+    Rollback {
+        /// The operation that originally failed.
+        #[source]
+        operation: Box<DeviceMgrError>,
+        /// The failure while cleaning up that operation.
+        cleanup: Box<DeviceMgrError>,
+    },
+
     #[cfg(feature = "host-device")]
     /// Error from Vfio Pci
     #[error("failed to do vfio pci operation: {0:?}")]
@@ -1276,6 +1286,8 @@ impl DeviceManager {
             align: 0,
             size: MMIO_DEFAULT_CFG_SIZE + DRAGONBALL_MMIO_DOORBELL_SIZE,
         };
+        let vm_as = ctx.get_vm_as()?;
+        let address_space = ctx.get_address_space()?;
         let mut requests = vec![MMIO_ADDRESS_DEFAULT];
         device.get_resource_requirements(&mut requests, use_generic_irq);
         let resources = ctx
@@ -1283,20 +1295,31 @@ impl DeviceManager {
             .allocate_device_resources(&requests, use_shared_irq)
             .map_err(|_| DeviceMgrError::GetDeviceResource)?;
 
-        let virtio_dev = match MmioV2Device::new(
+        let result = MmioV2Device::new(
             ctx.vm_fd.clone(),
-            ctx.get_vm_as()?,
-            ctx.get_address_space()?,
+            vm_as,
+            address_space,
             ctx.irq_manager.clone(),
             device,
-            resources,
+            resources.clone(),
             features,
-        ) {
-            Ok(d) => d,
-            Err(e) => return Err(DeviceMgrError::Virtio(e)),
-        };
-
-        Self::register_mmio_virtio_device(Arc::new(virtio_dev), ctx)
+        )
+        .map_err(DeviceMgrError::Virtio)
+        .and_then(|device| Self::register_mmio_virtio_device(Arc::new(device), ctx));
+        match result {
+            Ok(device) => Ok(device),
+            Err(operation) => {
+                // Failed registration cancels its IO transaction. Do not
+                // deregister the range: it may belong to an existing device.
+                match ctx.res_manager.free_device_resources(&resources) {
+                    Ok(()) => Err(operation),
+                    Err(cleanup) => Err(DeviceMgrError::Rollback {
+                        operation: Box::new(operation),
+                        cleanup: Box::new(DeviceMgrError::ResourceError(cleanup)),
+                    }),
+                }
+            }
+        }
     }
 
     fn destroy_mmio_device(
diff --git a/src/dragonball/src/device_manager/net_dev_mgr.rs b/src/dragonball/src/device_manager/net_dev_mgr.rs
index a95295be4..a08234884 100644
--- a/src/dragonball/src/device_manager/net_dev_mgr.rs
+++ b/src/dragonball/src/device_manager/net_dev_mgr.rs
@@ -406,7 +406,7 @@ impl NetworkDeviceMgr {
         if !config.num_queues().is_multiple_of(2) {
             return Err(NetworkDeviceError::InvalidQueueNum(config.num_queues()));
         }
-        if !cfg!(feature = "hotplug") && ctx.is_hotplug {
+        if !cfg!(all(feature = "hotplug", feature = "dbs-upcall")) && ctx.is_hotplug {
             return Err(NetworkDeviceError::UpdateNotAllowedPostBoot);
         }
         // Before boot a repeated id reconfigures the device, as it does for
@@ -446,25 +446,37 @@ impl NetworkDeviceMgr {
                 "id" => config.id(),
             );
 
-            match Self::create_device(&config, &mut ctx) {
-                Ok(device) => {
-                    let dev = DeviceManager::create_mmio_virtio_device(
-                        device,
-                        &mut ctx,
-                        config.use_shared_irq.unwrap_or(self.use_shared_irq),
-                        config.use_generic_irq(),
-                    )
-                    .map_err(NetworkDeviceError::DeviceManager)?;
-                    ctx.insert_hotplug_mmio_device(&dev, None)
-                        .map_err(NetworkDeviceError::DeviceManager)?;
-                    // live-upgrade need save/restore device from info.device.
-                    self.info_list[_device_index].set_device(dev);
-                }
-                Err(e) => {
-                    self.info_list.remove(_device_index);
-                    return Err(e);
+            let result = (|| {
+                let device = Self::create_device(&config, &mut ctx)?;
+                let dev = DeviceManager::create_mmio_virtio_device(
+                    device,
+                    &mut ctx,
+                    config.use_shared_irq.unwrap_or(self.use_shared_irq),
+                    config.use_generic_irq(),
+                )
+                .map_err(NetworkDeviceError::DeviceManager)?;
+                if let Err(operation) = ctx.insert_hotplug_mmio_device(&dev, None) {
+                    if let Err(cleanup) = DeviceManager::destroy_mmio_device(dev.clone(), &mut ctx)
+                    {
+                        // Retain uncertain resources for teardown and prevent
+                        // a retry from replacing their owner.
+                        self.info_list[_device_index].set_device(dev);
+                        return Err(NetworkDeviceError::DeviceManager(
+                            DeviceMgrError::Rollback {
+                                operation: Box::new(operation),
+                                cleanup: Box::new(cleanup),
+                            },
+                        ));
+                    }
+                    return Err(NetworkDeviceError::DeviceManager(operation));
                 }
+                self.info_list[_device_index].set_device(dev);
+                Ok(())
+            })();
+            if result.is_err() && self.info_list[_device_index].device.is_none() {
+                self.info_list.remove(_device_index);
             }
+            return result;
         }
 
         Ok(())
@@ -872,6 +884,210 @@ mod tests {
         }
     }
 
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    #[derive(Clone, Copy)]
+    enum HotplugFailure {
+        MissingMemory,
+        InvalidQueue,
+        Registration,
+        Upcall,
+    }
+
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    fn check_hotplug_failure_rollback(failure: HotplugFailure) {
+        use dbs_device::resources::ResourceConstraint;
+        use dbs_upcall::{DevMgrService, UpcallClient, UpcallClientError};
+        use dbs_virtio_devices::vsock::backend::VsockInnerBackend;
+
+        let missing_memory = matches!(failure, HotplugFailure::MissingMemory);
+        let invalid_queue = matches!(failure, HotplugFailure::InvalidQueue);
+        let registration_failure = matches!(failure, HotplugFailure::Registration);
+        let mut vm = create_vm_for_test();
+        let requests = [
+            ResourceConstraint::MmioAddress {
+                range: None,
+                align: 0,
+                size: 0x2000,
+            },
+            ResourceConstraint::LegacyIrq { irq: None },
+        ];
+        let resources = vm.device_manager().res_manager.clone();
+        let expected = resources
+            .allocate_device_resources(&requests, false)
+            .unwrap();
+        resources.free_device_resources(&expected).unwrap();
+        let mmio_base = expected.get_mmio_address_ranges()[0].0;
+        let scenario = failure as u8;
+        let tap_name = format!("db{:x}{scenario}", std::process::id());
+        let mut cfg = net_config(
+            Backend::Virtio(virtio_backend_config("rollback-net", &tap_name)),
+            "02:23:45:67:89:0a",
+            2,
+        );
+        cfg.use_shared_irq = Some(false);
+        cfg.use_generic_irq = Some(false);
+        if invalid_queue {
+            cfg.queue_size = Some(3);
+        }
+
+        if registration_failure {
+            use dbs_device::device_manager::IoManagerContext;
+            struct ExistingDevice;
+            impl dbs_device::DeviceIo for ExistingDevice {
+                fn read(
+                    &self,
+                    _: dbs_device::IoAddress,
+                    _: dbs_device::IoAddress,
+                    data: &mut [u8],
+                ) {
+                    data.fill(0xa5);
+                }
+                fn as_any(&self) -> &dyn std::any::Any {
+                    self
+                }
+            }
+            // Occupy the bus without reserving the allocator's next range.
+            let io = super::super::DeviceManagerContext::new(
+                vm.device_manager().io_manager.clone(),
+                vm.device_manager().io_lock.clone(),
+            );
+            let mut tx = io.begin_tx();
+            io.register_device_io(&mut tx, Arc::new(ExistingDevice), &expected)
+                .unwrap();
+            io.commit_tx(tx);
+        }
+
+        // Repeat with the same identity and resources: no failed attempt may
+        // reserve the device name, MMIO range, IRQ, or TAP for the next one.
+        for _ in 0..2 {
+            let mut ctx = DeviceOpContext::new(
+                Some(vm.epoll_manager().clone()),
+                vm.device_manager(),
+                if missing_memory {
+                    None
+                } else {
+                    vm.vm_as().cloned()
+                },
+                vm.vm_address_space().cloned(),
+                true,
+                Some(vm.vm_config().clone()),
+                vm.shared_info().clone(),
+            );
+            let vsock = VsockInnerBackend::new().unwrap();
+            ctx.upcall_client = Some(Arc::new(
+                UpcallClient::new(
+                    vsock.get_connector(),
+                    vm.epoll_manager().clone(),
+                    DevMgrService {},
+                )
+                .unwrap(),
+            ));
+            let err = vm
+                .device_manager_mut()
+                .net_manager
+                .insert_device(ctx, cfg.clone())
+                .unwrap_err();
+            if missing_memory {
+                assert!(matches!(
+                    err,
+                    NetworkDeviceError::DeviceManager(DeviceMgrError::InvalidOperation)
+                ));
+            } else if invalid_queue {
+                assert!(matches!(
+                    err,
+                    NetworkDeviceError::DeviceManager(DeviceMgrError::Virtio(_))
+                ));
+            } else if registration_failure {
+                assert!(matches!(
+                    err,
+                    NetworkDeviceError::DeviceManager(DeviceMgrError::IoManager(
+                        dbs_device::device_manager::Error::DeviceOverlap
+                    ))
+                ));
+            } else {
+                assert!(matches!(
+                    err,
+                    NetworkDeviceError::DeviceManager(DeviceMgrError::HotplugDevice(
+                        UpcallClientError::UpcallIsNotConnected
+                    ))
+                ));
+            }
+            assert!(vm.device_manager().net_manager.info_list.is_empty());
+            let mut value = [0; 4];
+            let read = vm
+                .device_manager()
+                .io_manager()
+                .load()
+                .mmio_read(mmio_base, &mut value);
+            if registration_failure {
+                read.unwrap();
+                assert_eq!(value, [0xa5; 4]);
+            } else {
+                assert!(read.is_err());
+            }
+            let reclaimed = resources
+                .allocate_device_resources(&requests, false)
+                .unwrap();
+            assert_eq!(reclaimed, expected);
+            resources.free_device_resources(&reclaimed).unwrap();
+            let tap = std::ffi::CString::new(tap_name.as_str()).unwrap();
+            // SAFETY: tap is a valid NUL-terminated interface name.
+            assert_eq!(unsafe { libc::if_nametoindex(tap.as_ptr()) }, 0);
+        }
+    }
+
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    #[test]
+    fn test_hotplug_net_missing_memory_rolls_back() {
+        skip_if_kvm_unaccessable!();
+        check_hotplug_failure_rollback(HotplugFailure::MissingMemory);
+    }
+
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    #[test]
+    fn test_hotplug_net_invalid_queue_rolls_back() {
+        skip_if_kvm_unaccessable!();
+        check_hotplug_failure_rollback(HotplugFailure::InvalidQueue);
+    }
+
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    #[test]
+    fn test_hotplug_net_upcall_failure_rolls_back() {
+        skip_if_kvm_unaccessable!();
+        check_hotplug_failure_rollback(HotplugFailure::Upcall);
+    }
+
+    #[cfg(all(feature = "virtio-net", feature = "hotplug", feature = "dbs-upcall"))]
+    #[test]
+    fn test_hotplug_net_registration_failure_preserves_existing_device() {
+        skip_if_kvm_unaccessable!();
+        check_hotplug_failure_rollback(HotplugFailure::Registration);
+    }
+
+    #[cfg(all(
+        feature = "virtio-net",
+        feature = "hotplug",
+        not(feature = "dbs-upcall")
+    ))]
+    #[test]
+    fn test_hotplug_net_without_upcall_rejected_before_config_mutation() {
+        skip_if_kvm_unaccessable!();
+        let vm = create_vm_for_test();
+        let mut mgr = DeviceManager::new_test_mgr();
+        let mut ctx = ctx_without_epoll_mgr(&mgr, &vm);
+        ctx.is_hotplug = true;
+        let cfg = net_config(
+            Backend::Virtio(virtio_backend_config("no-upcall", "unused-tap")),
+            "02:23:45:67:89:0a",
+            2,
+        );
+        assert!(matches!(
+            mgr.net_manager.insert_device(ctx, cfg),
+            Err(NetworkDeviceError::UpdateNotAllowedPostBoot)
+        ));
+        assert!(mgr.net_manager.info_list.is_empty());
+    }
+
     #[cfg(feature = "virtio-net")]
     #[test]
     fn test_network_interface_config_from_json() {
