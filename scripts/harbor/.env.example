# Only scripts/harbor/run_lab.py --oss-env reads this file.
# Copy to .env, fill the values, chmod 600 and chown to the Harbor runtime user.
# Endpoint and region must match the bucket; this is an example for Jakarta.
HARBOR_OSS_ENDPOINT=https://oss-ap-southeast-5-internal.aliyuncs.com
HARBOR_OSS_REGION=ap-southeast-5
HARBOR_OSS_BUCKET=
# Batch mode appends a Lab ID; shared templates append shared-templates-v1.
# This base prefix is exclusively for Harbor integration tests.
HARBOR_OSS_PREFIX=harbor/integration
HARBOR_OSS_ACCESS_KEY_ID=
HARBOR_OSS_ACCESS_KEY_SECRET=
# Optional STS token and expiration; replace credentials when expired.
HARBOR_OSS_SECURITY_TOKEN=
HARBOR_OSS_EXPIRATION=
