From 3d5bb6569b6fb1c7116721f2dbd09d22170a6fe5 Mon Sep 17 00:00:00 2001
From: Li Yi <denverdino@gmail.com>
Date: Tue, 6 Oct 2026 07:52:55 +0800
Subject: [PATCH] fix: respect enabled features in Dragonball block tests

Use PCI only when host-device is enabled and assert the existing hotplug-dependent removal contract. Verify unsupported PCI insertion leaves configuration unchanged.

Validated on Linux x86_64/KVM: original nine failures reproduced; corrected minimal profile 134 passed, 2 ignored; focused cases 10 passed. Expanded host-device/hotplug/dbs-upcall profile retains 8 passed and the existing PCI rate-limiter downcast failure. Runtime code and feature contracts are unchanged.
---
 src/dragonball/src/api/v1/vmm_action.rs       | 35 +++++++----
 .../src/device_manager/blk_dev_mgr.rs         | 58 ++++++++++++++-----
 2 files changed, 66 insertions(+), 27 deletions(-)

diff --git a/src/dragonball/src/api/v1/vmm_action.rs b/src/dragonball/src/api/v1/vmm_action.rs
index b70f85107..f56623dc1 100644
--- a/src/dragonball/src/api/v1/vmm_action.rs
+++ b/src/dragonball/src/api/v1/vmm_action.rs
@@ -1867,7 +1867,7 @@ mod tests {
                     queue_size: 256,
                     use_shared_irq: None,
                     use_generic_irq: None,
-                    use_pci_bus: Some(true),
+                    use_pci_bus: Some(cfg!(feature = "host-device")),
                 }),
                 InstanceState::Uninitialized,
                 &|result| {
@@ -1939,21 +1939,32 @@ mod tests {
                     assert_eq!(err_string, expected_err);
                 },
             ),
-            // invalid id
+            // Removal is unavailable without hotplug, even before boot.
             TestData::new(
                 VmmAction::RemoveBlockDevice(String::from("1")),
                 InstanceState::Uninitialized,
                 &|result| {
-                    assert!(matches!(
-                        result,
-                        Err(VmmActionError::Block(BlockDeviceError::InvalidDeviceId(_)))
-                    ));
-                    let err_string = format!("{}", result.unwrap_err());
-                    let expected_err = String::from(
-                        "virtio-blk device error: \
-                    invalid block device id '1'",
-                    );
-                    assert_eq!(err_string, expected_err);
+                    if cfg!(feature = "hotplug") {
+                        assert!(matches!(
+                            result,
+                            Err(VmmActionError::Block(BlockDeviceError::InvalidDeviceId(_)))
+                        ));
+                        assert_eq!(
+                            result.unwrap_err().to_string(),
+                            "virtio-blk device error: invalid block device id '1'"
+                        );
+                    } else {
+                        assert!(matches!(
+                            result,
+                            Err(VmmActionError::Block(
+                                BlockDeviceError::UpdateNotAllowedPostBoot
+                            ))
+                        ));
+                        assert_eq!(
+                            result.unwrap_err().to_string(),
+                            "virtio-blk device error: block device does not support runtime update"
+                        );
+                    }
                 },
             ),
         ];
